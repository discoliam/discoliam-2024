{% assign navPages = collections.header | eleventyNavigation %}

<header class='Header'>
  <div class='Container Header__Inner'>
    <a class='Header__Logo' href='/'>
      {% svg "logo" %}
      <span class='sr-only'>{{ site.name }} – home</span>
    </a>

    {% comment %} Only shown when JS is available (html.js), so the nav is always reachable without it {% endcomment %}
    <button class='Header__Toggle' type='button' aria-expanded='false' aria-controls='site-nav'>
      <span class='Header__ToggleIcon' aria-hidden='true'>
        <span></span>
        <span></span>
        <span></span>
      </span>
      <span class='sr-only'>Menu</span>
    </button>

    <nav class='Header__Nav' id='site-nav' aria-label='Main'>
      <ul class='MainNav'>
        {% for entry in navPages %}
          <li class='MainNav__Item'>
            <a
              class='MainNav__Link'
              href='{{ entry.url | url }}'
              {% if entry.url == page.url %}
                aria-current='page'
              {% endif %}
            >
              {{- entry.title -}}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </div>
</header>

{% layout 'layouts/base.liquid' %}

{%- block content -%}

<div class='Container'>
  <div class='Page__Header Page__Header--centered'>
    <div>
      <h1>{{ pageTitle }}</h1>
    </div>
  </div>

  {% image hero, pageTitle, "Portfolio__Image", "100vw", "eager" %}

  <div class='Portfolio__Intro'>
    <div class='Project__Info'>
      <dl>
        <dt>Project</dt>
        <dd>{{ pageTitle }}</dd>
        {% if eleventyNavigation.client %}
          <dt>Client</dt>
          <dd>{{ eleventyNavigation.client }}</dd>
        {% endif %}
        {% if year %}
          <dt>Year</dt>
          <dd>{{ year }}</dd>
        {% endif %}
        {% if eleventyNavigation.tags %}
          <dt>Tech Stack</dt>
          <dd>
            {% for tag in eleventyNavigation.tags %}
              <span class='Label'>{{ tag }}</span>
            {% endfor %}
          </dd>
        {% endif %}
        {% if website %}
          <dt>Website</dt>
          <dd>
            <a href='{{website}}' target='_blank' rel='noopener'>
              {{- website }}
              <span class='sr-only'> - Opens in new window</span></a
            >
          </dd>
        {% endif %}
      </dl>
    </div>
    <div class='Project__Excerpt'>
      <div class='ContentWrapper'>
        <div class='Lead'>{{ eleventyNavigation.excerpt }}</div>
        {{- content -}}
      </div>
    </div>
  </div>

  {% assign portfolioEntries = collections.all | eleventyNavigation: 'Portfolio' %}
  {% assign related = portfolioEntries | relatedProjects: eleventyNavigation.key, 3 %}
  {% if related.size > 0 %}
    <section class='RelatedWork' aria-labelledby='related-work-title'>
      <h2 id='related-work-title'>Related projects</h2>
      <ul class='PortfolioNav PortfolioNav--related'>
        {% for entry in related %}
          {% include 'portfolio-card.liquid', entry: entry, headingLevel: 'h3', compact: true %}
        {% endfor %}
      </ul>
      <a href='/portfolio/' class='Button'>View all projects</a>
    </section>
  {% endif %}
</div>

{%- endblock -%}
